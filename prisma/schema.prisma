generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. USER & AUTHENTICATION MODELS
// ==========================================

enum UserStatus {
  ONLINE
  OFFLINE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model User {
  id              String       @id @default(uuid())
  name            String
  email           String       @unique
  username        String       @unique
  password        String?
  avatar          String?
  bio             String?
  provider        AuthProvider @default(LOCAL)
  status          UserStatus   @default(OFFLINE)
  lastSeen        DateTime     @default(now())
  isEmailVerified Boolean      @default(false)
  emailVerifiedAt DateTime?

  verificationCode       String?
  verificationCodeExpire DateTime?
  verificationAttempts   Int       @default(0)
  verificationLastSentAt DateTime?

  pendingEmail            String?   @unique
  pendingEmailRequestedAt DateTime?

  refreshTokens RefreshToken[]

  accountPublicKey String?
  devices          Device[]
  keyBackup        KeyBackup?
  accountKeys      ConversationAccountKey[]

  sentFriendRequests     Friendship[] @relation("Sender")
  receivedFriendRequests Friendship[] @relation("Receiver")
  blocksGiven            Block[]      @relation("Blocker")
  blocksReceived         Block[]      @relation("Blocked")

  conversations        ConversationParticipant[]
  createdConversations Conversation[]            @relation("ConversationCreator")
  messages             Message[]
  messageReactions     MessageReaction[]
  messageDeletions     MessageDeletion[]

  stories    Story[]
  storyViews StoryView[]

  notifications          Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  deviceId  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
}

// ==========================================
// 2. END-TO-END ENCRYPTION
// ==========================================

model Device {
  id          String  @id @default(uuid())
  userId      String
  name        String
  platform    String?
  browser     String?
  os          String?
  deviceModel String?
  appVersion  String?
  userAgent   String?
  ip          String?

  publicKey       String?
  keyRegisteredAt DateTime?

  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  chatKeys      ConversationDeviceKey[]

  @@index([userId, revokedAt])
}

model ConversationDeviceKey {
  id             String   @id @default(uuid())
  conversationId String
  deviceId       String
  epoch          Int
  wrappedKey     String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([conversationId, deviceId, epoch])
  @@index([deviceId])
}

model ConversationAccountKey {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  epoch          Int
  wrappedKey     String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId, epoch])
  @@index([userId])
}

model KeyBackup {
  id        String   @id @default(uuid())
  userId    String   @unique
  data      Bytes
  salt      String
  kdf       String
  kdfParams Json
  version   Int      @default(1)
  sizeBytes Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 3. FRIENDSHIP & BLOCK SYSTEM
// ==========================================

enum FriendStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id         String @id @default(uuid())
  senderId   String
  receiverId String

  pairKey String @unique

  status     FriendStatus @default(PENDING)
  acceptedAt DateTime?

  sender   User @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId, status])
  @@index([receiverId, status])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ==========================================
// 4. CONVERSATIONS (DIRECT + GROUP)
// ==========================================

enum ConversationType {
  DIRECT
  GROUP
}

enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

model Conversation {
  id   String           @id @default(uuid())
  type ConversationType @default(DIRECT)

  directKey String? @unique

  name        String?
  avatar      String?
  description String?
  createdById String?
  createdBy   User?   @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  keyEpoch      Int     @default(0)
  rekeyRequired Boolean @default(false)

  lastMessageAt DateTime @default(now())

  participants  ConversationParticipant[]
  notifications Notification[]
  messages      Message[]
  deviceKeys    ConversationDeviceKey[]
  accountKeys   ConversationAccountKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConversationParticipant {
  id             String          @id @default(uuid())
  conversationId String
  userId         String
  role           ParticipantRole @default(MEMBER)

  clearedAt DateTime?

  lastReadAt      DateTime?
  lastDeliveredAt DateTime?

  mutedUntil DateTime?
  pinnedAt   DateTime?
  isArchived Boolean   @default(false)

  leftAt   DateTime?
  joinedAt DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// ==========================================
// 5. MESSAGES
// ==========================================

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  VOICE
  SYSTEM
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String?
  type           MessageType @default(TEXT)

  content String?

  ciphertext String?
  keyEpoch   Int?

  mediaUrl     String?
  thumbnailUrl String?
  mediaSize    Int?

  metadata Json?

  replyToId String?
  storyId   String?
  clientId  String?

  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReplies")
  story        Story?       @relation("StoryReplies", fields: [storyId], references: [id], onDelete: SetNull)

  reactions MessageReaction[]
  deletions MessageDeletion[]

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt, id])
  @@index([senderId])
  @@index([storyId])
}

model MessageDeletion {
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

// ==========================================
// 6. STORIES SYSTEM
// ==========================================

enum StoryType {
  IMAGE
  VIDEO
  TEXT
}

model Story {
  id     String    @id @default(uuid())
  userId String
  type   StoryType

  mediaUrl      String?
  thumbnailUrl  String?
  mediaWidth    Int?
  mediaHeight   Int?
  mediaDuration Int?

  caption         String?
  backgroundColor String?

  expiresAt DateTime
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  views   StoryView[]
  replies Message[]   @relation("StoryReplies")

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([storyId, viewerId])
  @@index([viewerId])
}

// ==========================================
// 7. NOTIFICATIONS
// ==========================================

enum NotificationType {
  SYSTEM
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  GROUP_ADDED
}

model Notification {
  id             String           @id @default(uuid())
  userId         String
  actorId        String
  type           NotificationType
  friendshipId   String?
  conversationId String?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  user         User          @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor        User          @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  friendship   Friendship?   @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, type, friendshipId])
  @@index([userId, isRead, createdAt])
  @@index([conversationId])
}
