generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. USER & AUTHENTICATION MODELS
// ==========================================

enum UserStatus {
  ONLINE
  OFFLINE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model User {
  id              String       @id @default(uuid())
  name            String
  email           String       @unique
  username        String       @unique
  password        String?
  avatar          String?
  bio             String?
  provider        AuthProvider @default(LOCAL)
  status          UserStatus   @default(OFFLINE)
  lastSeen        DateTime     @default(now())
  isEmailVerified Boolean      @default(false)
  emailVerifiedAt DateTime?

  verificationCode       String?
  verificationCodeExpire DateTime?
  verificationAttempts   Int       @default(0)
  verificationLastSentAt DateTime?

  refreshTokens RefreshToken[]

  sentFriendRequests     Friendship[] @relation("Sender")
  receivedFriendRequests Friendship[] @relation("Receiver")
  blocksGiven            Block[]      @relation("Blocker")
  blocksReceived         Block[]      @relation("Blocked")

  conversations        ConversationParticipant[]
  createdConversations Conversation[]            @relation("ConversationCreator")
  messages             Message[]
  messageReactions     MessageReaction[]
  messageDeletions     MessageDeletion[]

  stories    Story[]
  storyViews StoryView[]

  notifications          Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

// ==========================================
// 2. FRIENDSHIP & BLOCK SYSTEM
// ==========================================

enum FriendStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id         String @id @default(uuid())
  senderId   String
  receiverId String

  pairKey String @unique

  status     FriendStatus @default(PENDING)
  acceptedAt DateTime?

  sender   User @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId, status])
  @@index([receiverId, status])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ==========================================
// 3. CONVERSATIONS (DIRECT + GROUP)
// ==========================================

enum ConversationType {
  DIRECT
  GROUP
}

enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

model Conversation {
  id   String           @id @default(uuid())
  type ConversationType @default(DIRECT)

  directKey String? @unique

  name        String?
  avatar      String?
  description String?
  createdById String?
  createdBy   User?   @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  lastMessageAt DateTime @default(now())

  participants  ConversationParticipant[]
  notifications Notification[]
  messages      Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConversationParticipant {
  id             String          @id @default(uuid())
  conversationId String
  userId         String
  role           ParticipantRole @default(MEMBER)

  clearedAt DateTime?

  lastReadAt      DateTime?
  lastDeliveredAt DateTime?

  mutedUntil DateTime?
  pinnedAt   DateTime?
  isArchived Boolean   @default(false)

  leftAt   DateTime?
  joinedAt DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// ==========================================
// 4. MESSAGES
// ==========================================

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  VOICE
  SYSTEM
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String?
  type           MessageType @default(TEXT)
  content        String?

  mediaUrl      String?
  thumbnailUrl  String?
  mediaMimeType String?
  fileName      String?
  mediaSize     Int?
  mediaWidth    Int?
  mediaHeight   Int?
  mediaDuration Int?

  metadata Json?

  replyToId String?
  storyId   String?
  clientId  String?

  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReplies")
  story        Story?       @relation("StoryReplies", fields: [storyId], references: [id], onDelete: SetNull)

  reactions MessageReaction[]
  deletions MessageDeletion[]

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt, id])
  @@index([senderId])
  @@index([storyId])
}

model MessageDeletion {
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

// ==========================================
// 5. STORIES SYSTEM
// ==========================================

enum StoryType {
  IMAGE
  VIDEO
  TEXT
}

model Story {
  id     String    @id @default(uuid())
  userId String
  type   StoryType

  mediaUrl      String?
  thumbnailUrl  String?
  mediaWidth    Int?
  mediaHeight   Int?
  mediaDuration Int?

  caption         String?
  backgroundColor String?

  expiresAt DateTime
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  views   StoryView[]
  replies Message[]   @relation("StoryReplies")

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([storyId, viewerId])
  @@index([viewerId])
}

// ==========================================
// 6. NOTIFICATIONS
// ==========================================

enum NotificationType {
  SYSTEM
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  GROUP_ADDED
}

model Notification {
  id             String           @id @default(uuid())
  userId         String
  actorId        String
  type           NotificationType
  friendshipId   String?
  conversationId String?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  user         User          @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor        User          @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  friendship   Friendship?   @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, type, friendshipId])
  @@index([userId, isRead, createdAt])  
  @@index([conversationId])
}
